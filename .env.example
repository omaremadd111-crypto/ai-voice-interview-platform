# Safe default: the complete core flow runs without an external LLM.
MOCK_MODE=true
LLM_PROVIDER=mistral

# Real LLM providers. Configure only the selected provider when MOCK_MODE=false.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Reserved for a future provider adapter; Anthropic is not implemented.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Document and interview limits
MAX_DOC_CHARS=20000
MAX_CV_UPLOAD_BYTES=5242880
MAX_FOLLOW_UPS_PER_QUESTION=2
LOG_LEVEL=INFO

# PostgreSQL. Supply real values only in the ignored .env file.
DATABASE_URL=

# Optional separate disposable database for PostgreSQL-backed tests.
# The database test fixtures rebuild its entire schema.
TEST_DATABASE_URL=

# FastAPI authentication and browser origins.
# Generate JWT_SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Public application surface. Disabled routes return 404 at the framework level.
PUBLIC_APPLICATIONS_ENABLED=false
PUBLIC_APPLY_RATE_LIMIT_PER_IP_PER_HOUR=5

# Background worker leases and deterministic retry policy.
QUEUE_WORKER_LEASE_SECONDS=300
QUEUE_WORKER_POLL_INTERVAL_SECONDS=5
QUEUE_RETRY_BASE_SECONDS=30
QUEUE_RETRY_FACTOR=2
QUEUE_RETRY_MAX_SECONDS=900

# Interview transport: null | livekit
INTERVIEW_TRANSPORT=null
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=hr-screening-agent
LIVEKIT_STT_MODEL=deepgram/nova-3

# LiveKit Inference TTS: cartesia | inworld
VOICE_TTS_PROVIDER=cartesia
LIVEKIT_TTS_MODEL=
LIVEKIT_TTS_VOICE=

# Signed candidate links and voice-session limits.
VOICE_PUBLIC_BASE_URL=http://localhost:5173
VOICE_INVITE_SECRET=
VOICE_JOIN_TIMEOUT_SECONDS=600
VOICE_INTERVIEW_TIMEOUT_SECONDS=3600
VOICE_TRANSPORT_POLL_INTERVAL_SECONDS=1
VOICE_TOKEN_TTL_SECONDS=900

# Semantic response handling and silence escalation.
VOICE_SEMANTIC_LAYER_ENABLED=true
VOICE_INTENT_CLASSIFIER_TIMEOUT_SECONDS=4.0
VOICE_INTENT_MIN_CONFIDENCE=0.55
VOICE_SILENCE_LAYER_ENABLED=true
VOICE_THINK_PAUSE_SECONDS=6.0
VOICE_PRESENCE_CHECK_SECONDS=15.0
VOICE_PRESENCE_RETRY_SECONDS=25.0
VOICE_NO_RESPONSE_SECONDS=45.0
VOICE_MAX_NUDGES_PER_QUESTION=2
VOICE_SILENCE_POLL_INTERVAL_SECONDS=0.5
VOICE_MAX_REPEATS_PER_QUESTION=2

# Voice idle nudges.
VOICE_IDLE_NUDGE_ENABLED=true
VOICE_IDLE_FIRST_NUDGE_SECONDS=8.0
VOICE_IDLE_SECOND_NUDGE_SECONDS=9.0

# Turn detection and streaming voice engine.
VOICE_TURN_DETECTION_MODE=default
VOICE_ENGINE=v2
LIVEKIT_VOICE_LLM_MODEL=google/gemini-3-flash
VOICE_MIN_ENDPOINTING_DELAY=0.4
VOICE_MAX_ENDPOINTING_DELAY=2.0
VOICE_ENDPOINTING_ALPHA=0.9
VOICE_MIN_INTERRUPTION_DURATION=0.4
VOICE_INTERRUPTION_MIN_WORDS=1
VOICE_FALSE_INTERRUPTION_TIMEOUT=2.0
VOICE_PREEMPTIVE_GENERATION=true
VOICE_PREEMPTIVE_TTS=true

# Optional recording and transcript persistence. Recording requires reachable
# S3-compatible storage because LiveKit egress runs outside this machine.
RECORDING_ENABLED=false
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ENDPOINT=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_S3_FORCE_PATH_STYLE=false
RECORDING_PUBLIC_BASE_URL=
VOICE_TRANSCRIPT_FLUSH_INTERVAL_SECONDS=2.0
RECORDING_CONSENT_VERSION=v1
RECORDING_CONSENT_REQUIRED=false

# Transactional invitation email: null | smtp
EMAIL_PROVIDER=null
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_OUTBOX_MAX_ATTEMPTS=5
