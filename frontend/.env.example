# Base URL of the FastAPI backend.
# Leave blank for local development: vite.config.ts proxies /api and /health to
# http://127.0.0.1:8000, so the browser stays on a single origin and no CORS
# configuration is required.
# For a deployed frontend, set this to the API's public origin, e.g.
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
